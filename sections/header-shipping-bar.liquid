<div class="header-shopping-bar">
  <div class="container">
    New header section
    {{ section.settings.shipping-text }}
  </div>
</div>

<style>
  .header-shipping-bar {
    background-color: {{ section.settings.bg_color }};
  }
</style>

{% schema %}
{
    "name": "Shipping Bar",
    "settings": [
        {"type": "text",
        "id": "shipping-text",
        "label": "title",
        "default": "Free Shipping on all Orders"
        },
        {
      "type": "color",
      "id": "bg-color",
      "label": "Hintergrundfarbe",
      "default": "#00ff00"
        }
    ]
}
{% endschema %}